# ===========================================
# E-Commerce Django Application
# Environment Configuration Template
# ===========================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in all the values below
# 3. NEVER commit .env to version control
#
# Generate secure keys:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
# ===========================================

# ===========================================
# DJANGO CORE SETTINGS
# ===========================================
DEBUG=True
SECRET_KEY=GENERATE-A-SECURE-50+CHARACTER-KEY-HERE
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# DATABASE SETTINGS
# ===========================================
# Development: SQLite is used by default
# Production: Use PostgreSQL

DB_NAME=ecomm_db
DB_USER=postgres
DB_PASSWORD=YOUR-SECURE-DATABASE-PASSWORD
DB_HOST=localhost
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Required for caching, sessions, and Celery
REDIS_URL=redis://127.0.0.1:6379/1

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ===========================================
# JWT CONFIGURATION
# ===========================================
JWT_SECRET_KEY=GENERATE-ANOTHER-SECURE-KEY-HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
# Use Test Mode keys for development
RAZORPAY_KEY_ID=YOUR-RAZORPAY-KEY-ID
RAZORPAY_KEY_SECRET=YOUR-RAZORPAY-KEY-SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR-WEBHOOK-SECRET

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Set these to True in production with HTTPS
SECURE_SSL_REDIRECT=False
SECURE_HSTS=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# Add your domain(s) here
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ===========================================
# CORS SETTINGS
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# EMAIL SETTINGS
# ===========================================
# Development: Uses console backend
# Production: Configure SMTP or service (SendGrid, AWS SES, etc.)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ===========================================
# APPLICATION SETTINGS
# ===========================================
SITE_NAME=E-Commerce Store
SITE_URL=http://localhost:8000

# ===========================================
# LOGGING
# ===========================================
DJANGO_LOG_LEVEL=INFO

# ===========================================
# SENTRY (Error Tracking - Optional)
# ===========================================
SENTRY_DSN=
